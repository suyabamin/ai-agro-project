rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AGROAI FIRESTORE SECURITY RULES
    // Fully functional role-based access & dev fallback
    // ==========================================

    // Users collection & sub-profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Farms collection
    match /farms/{farmId} {
      allow read, write: if true;
    }

    // Fields collection & field subcollections
    match /fields/{fieldId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Assignment Requests: owner & farmer workflow
    match /assignment_requests/{requestId} {
      allow read, write: if true;
    }

    // Assignments history records
    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    // Field Assignments (audit log)
    match /field_assignments/{assignmentId} {
      allow read, write: if true;
    }

    // Field Data submissions (soil moisture, pH, telemetry)
    match /field_data/{dataId} {
      allow read, write: if true;
    }

    // Field Images & Drone scans
    match /field_images/{imageId} {
      allow read, write: if true;
    }

    // Conversations & nested message subcollections
    match /conversations/{conversationId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Root Messages collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Activity Logs & Audit history
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Farmer Ratings & Reviews
    match /farmer_ratings/{ratingId} {
      allow read, write: if true;
    }

    // Legacy logs collection
    match /logs/{logId} {
      allow read, write: if true;
    }

    // Universal catch-all fallback for smooth operation & development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
